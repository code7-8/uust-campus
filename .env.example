# Example only. server.py reads process environment, not this file automatically.
# Render supplies RENDER_EXTERNAL_URL; on another host set PUBLIC_URL yourself.
CAMPUS_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_URL=https://campus.example.org
DATABASE_PATH=/data/campus.sqlite
ADMIN_USERNAME=campus_admin
# Supply a unique password (at least 12 characters) in the hosting secret settings.
ADMIN_PASSWORD=
ADMIN_NAME=Campus administrator
THREADS=8
# Optional additional browser origins, separated by commas. Never use '*'.
CORS_ORIGINS=
# Set only behind a proxy that overwrites forwarded headers; see docs/SERVER.md.
TRUSTED_PROXY=
TRUSTED_PROXY_COUNT=1
AUTH_RATE_LIMIT=25
REQUEST_RATE_LIMIT=300
LOG_LEVEL=INFO
